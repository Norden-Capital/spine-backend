# Spine API site block for the EXISTING Caddy on the VPS.
# Import it from the main Caddyfile (see deploy/README.md), then reload Caddy.
#
# Hostname: we have no domain yet. Until then you can use a free host name
# built from the VPS IP, for example (IP 203.0.113.10):
#   api.203-0-113-10.sslip.io   or   api.203.0.113.10.nip.io
# Caddy gets a real HTTPS certificate for these automatically.
# Replace it with the real domain later (e.g. api.example.com).
#
# Port: must match SPINE_API_PORT in /opt/spine/.env (default 8090).
#
# This assumes Caddy runs on the host (systemd). If Caddy runs in a Docker
# container, 127.0.0.1 is the container itself; then use host.docker.internal
# (with extra_hosts: host-gateway) or the host network instead.

spine-api.CHANGE-ME.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090
}
