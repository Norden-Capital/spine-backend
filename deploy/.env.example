# Server env file for deploy/compose.prod.yaml.
# Copy to /opt/spine/.env on the VPS, fill in real values, then: chmod 600 .env
# Never commit the real .env.

# --- Postgres (used by the db container) ---
POSTGRES_DB=spine
POSTGRES_USER=spine
# Make a long random one, e.g.: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# --- Spring Boot (used by the api container) ---
# "db" is the Postgres service name inside the spine network.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/spine
# These copy the Postgres values above, so you set them only once.
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# Comma-separated list of frontend origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=https://spine-frontend-ten.vercel.app

# --- Deploy ---
# Image tag to run: "latest" or a short git sha (for a rollback).
# The deploy workflow sets this for each deploy.
IMAGE_TAG=latest
# Host port for the API. Must be free on the VPS.
SPINE_API_PORT=8090
# Address the API port listens on. 0.0.0.0 = public (TEMPORARY, so Vercel can
# proxy to it). Use 127.0.0.1 once a Cloudflare Tunnel + domain is in front.
SPINE_API_BIND=0.0.0.0
