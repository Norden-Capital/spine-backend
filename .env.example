# Copy to .env (never commit .env) or set these in your shell / hosting platform.

# Spring profile: leave empty for local, use "prod" in production.
SPRING_PROFILES_ACTIVE=

# Database (local defaults match compose.yaml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/spine
SPRING_DATASOURCE_USERNAME=spine
SPRING_DATASOURCE_PASSWORD=spine

# HTTP port
SERVER_PORT=8080

# Allowed CORS origins for /api/**, comma-separated (e.g. the Vercel frontend URL)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Links in emails point here (e.g. http://localhost:3000/set-password?token=...)
APP_FRONTEND_URL=http://localhost:3000
# Email sender
APP_MAIL_FROM="Spine <no-reply@localhost>"
# Leave empty locally: emails are printed to the console instead of sent.
RESEND_API_KEY=
# First admin, invited on startup when there is no user at all
APP_BOOTSTRAP_ADMIN_EMAIL=admin@nordencapital.ca
